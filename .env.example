# StayEase Environment Configuration

# Server Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api

# Database Connection (PostgreSQL)
# For embedded/local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/stayease?schema=public
# Or for standard local/cloud PostgreSQL:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/stayease?schema=public

# Authentication & Security
JWT_SECRET=super_secret_stayease_jwt_key_32_characters_minimum_12345
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_stayease_cookie_key_32_chars_min_67890

# Razorpay Test Mode Payment Gateway
# When not set, the application operates in safe development simulated mode.
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_key

# Cloudinary Storage
# When not set, fallback local and curated hotel photo CDN URLs are utilized.
CLOUDINARY_CLOUD_NAME=stayease-demo
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Transactional Email (SMTP)
# When not set or invalid, emails are logged safely to server console.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=StayEase Reservations <reservations@stayease.com>
