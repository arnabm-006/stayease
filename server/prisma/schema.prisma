datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  RECEPTIONIST
  HOTEL_MANAGER
  SUPER_ADMIN
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum NotificationType {
  BOOKING
  PAYMENT
  SYSTEM
  PROMOTION
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  passwordHash         String
  firstName            String
  lastName             String
  phone                String?
  role                 Role           @default(CUSTOMER)
  isActive             Boolean        @default(true)
  hotelId              String?        // Assigned hotel for RECEPTIONIST / HOTEL_MANAGER
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  assignedHotel        Hotel?         @relation("HotelStaff", fields: [hotelId], references: [id], onDelete: SetNull)
  bookings             Booking[]
  reviews              Review[]
  favorites            Favorite[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@index([email])
  @@index([role])
  @@index([hotelId])
}

model Hotel {
  id                 String         @id @default(uuid())
  name               String
  slug               String         @unique
  description        String
  address            String
  city               String
  state              String
  country            String
  postalCode         String
  latitude           Float?
  longitude          Float?
  phone              String
  email              String
  starRating         Int            @default(4)
  checkInTime        String         @default("14:00")
  checkOutTime       String         @default("11:00")
  cancellationPolicy String         @default("Free cancellation up to 48 hours before check-in.")
  isPublished        Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  staff              User[]         @relation("HotelStaff")
  images             HotelImage[]
  amenities          HotelAmenity[]
  roomTypes          RoomType[]
  rooms              Room[]
  bookings           Booking[]
  reviews            Review[]
  favorites          Favorite[]
  maintenances       Maintenance[]
  auditLogs          AuditLog[]

  @@index([city])
  @@index([starRating])
  @@index([isPublished])
}

model HotelImage {
  id        String   @id @default(uuid())
  hotelId   String
  url       String
  caption   String?
  isCover   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

model Amenity {
  id          String         @id @default(uuid())
  name        String         @unique
  icon        String?
  category    String         @default("General")
  description String?

  hotels      HotelAmenity[]
}

model HotelAmenity {
  hotelId   String
  amenityId String

  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([hotelId, amenityId])
}

model RoomType {
  id           String        @id @default(uuid())
  hotelId      String
  name         String
  description  String
  basePrice    Decimal       @db.Decimal(10, 2)
  maxOccupancy Int           @default(2)
  maxAdults    Int           @default(2)
  maxChildren  Int           @default(1)
  bedConfig    String        @default("1 King Bed")
  roomSizeSqFt Int           @default(350)
  imageUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms        Room[]
  roomRates    RoomRate[]
  bookingRooms BookingRoom[]

  @@index([hotelId])
}

model Room {
  id           String        @id @default(uuid())
  hotelId      String
  roomTypeId   String
  roomNumber   String
  floor        Int           @default(1)
  status       RoomStatus    @default(AVAILABLE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType     RoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  bookingRooms BookingRoom[]
  maintenances Maintenance[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId])
  @@index([roomTypeId])
  @@index([status])
}

model RoomRate {
  id            String   @id @default(uuid())
  roomTypeId    String
  startDate     DateTime
  endDate       DateTime
  nightlyRate   Decimal  @db.Decimal(10, 2)
  isWeekendRate Boolean  @default(false)
  isSeasonal    Boolean  @default(false)
  minNights     Int      @default(1)
  createdAt     DateTime @default(now())

  roomType      RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId])
  @@index([startDate, endDate])
}

model Booking {
  id                 String         @id @default(uuid())
  bookingReference   String         @unique
  customerId         String
  hotelId            String
  checkInDate        DateTime
  checkOutDate       DateTime
  numAdults          Int            @default(1)
  numChildren        Int            @default(0)
  totalNights        Int
  status             BookingStatus  @default(PENDING)
  holdExpiresAt      DateTime?
  baseTotal          Decimal        @db.Decimal(10, 2)
  discountTotal      Decimal        @default(0) @db.Decimal(10, 2)
  taxTotal           Decimal        @db.Decimal(10, 2)
  serviceFeeTotal    Decimal        @default(0) @db.Decimal(10, 2)
  grandTotal         Decimal        @db.Decimal(10, 2)
  currency           String         @default("USD")
  cancellationReason String?
  cancelledAt        DateTime?
  cancellationFee    Decimal?       @db.Decimal(10, 2)
  specialRequests    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  customer           User           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  hotel              Hotel          @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  bookingRooms       BookingRoom[]
  guests             Guest[]
  payments           Payment[]
  bookingCoupons     BookingCoupon[]
  review             Review?

  @@index([bookingReference])
  @@index([customerId])
  @@index([hotelId])
  @@index([status])
  @@index([checkInDate, checkOutDate])
}

model BookingRoom {
  id                  String   @id @default(uuid())
  bookingId           String
  roomTypeId          String
  roomId              String?  // Physical room allocated
  allocatedAt         DateTime?
  nightlyRateSnapshot Decimal  @db.Decimal(10, 2)
  guestName           String?

  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType            RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  room                Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([roomTypeId])
  @@index([roomId])
}

model Guest {
  id                   String   @id @default(uuid())
  bookingId            String
  firstName            String
  lastName             String
  email                String
  phone                String?
  isPrimary            Boolean  @default(false)
  identificationType   String?
  identificationNumber String?

  booking              Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Payment {
  id                   String        @id @default(uuid())
  bookingId            String
  orderReference       String        @unique // e.g. Razorpay Order ID or Internal Order ID
  transactionReference String?       // e.g. Razorpay Payment ID
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("USD")
  status               PaymentStatus @default(PENDING)
  method               String?       // card, upi, netbanking, test_simulator
  paymentProvider      String        @default("razorpay")
  failureReason        String?
  signature            String?
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  booking              Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refunds              Refund[]

  @@index([bookingId])
  @@index([orderReference])
  @@index([transactionReference])
  @@index([status])
}

model Refund {
  id              String       @id @default(uuid())
  paymentId       String
  refundReference String       @unique
  amount          Decimal      @db.Decimal(10, 2)
  reason          String?
  status          RefundStatus @default(PENDING)
  processedAt     DateTime?
  createdAt       DateTime     @default(now())

  payment         Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([refundReference])
}

model Coupon {
  id                String          @id @default(uuid())
  code              String          @unique
  description       String
  discountType      DiscountType
  discountValue     Decimal         @db.Decimal(10, 2)
  minBookingAmount  Decimal         @default(0) @db.Decimal(10, 2)
  maxDiscountAmount Decimal?        @db.Decimal(10, 2)
  startDate         DateTime
  endDate           DateTime
  usageLimit        Int             @default(100)
  usedCount         Int             @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  bookingCoupons    BookingCoupon[]

  @@index([code])
  @@index([isActive])
}

model BookingCoupon {
  id              String   @id @default(uuid())
  bookingId       String
  couponId        String
  discountApplied Decimal  @db.Decimal(10, 2)

  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@unique([bookingId, couponId])
  @@index([bookingId])
}

model Review {
  id                 String   @id @default(uuid())
  hotelId            String
  bookingId          String   @unique
  userId             String
  rating             Int      // 1 to 5
  title              String
  comment            String
  staffRating        Int      @default(5)
  cleanlinessRating  Int      @default(5)
  comfortRating      Int      @default(5)
  locationRating     Int      @default(5)
  isApproved         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  hotel              Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  hotelId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@index([userId])
  @@index([hotelId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(BOOKING)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  hotelId   String?
  action    String
  entity    String
  entityId  String?
  details   String?  // JSON stringified details
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  hotel     Hotel?   @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([hotelId])
  @@index([entity])
  @@index([createdAt])
}

model Maintenance {
  id          String              @id @default(uuid())
  roomId      String
  hotelId     String
  title       String
  description String?
  priority    MaintenancePriority @default(MEDIUM)
  status      MaintenanceStatus   @default(SCHEDULED)
  startDate   DateTime
  endDate     DateTime
  cost        Decimal?            @db.Decimal(10, 2)
  createdBy   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  room        Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  hotel       Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([hotelId])
  @@index([status])
  @@index([startDate, endDate])
}
